# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND (BANUAT)
# ==============================================================================

# Puerto local del servidor Express
PORT=3001

# Cadena de conexión MySQL / MariaDB para Prisma ORM
# Formato general: mysql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BASE_DE_DATOS
# 
# NOTA: La base de datos oficial se llama obligatoriamente: cooperativa_financiera
#
# Opción 1: MySQL Server local (con contraseña de usuario root)
DATABASE_URL="mysql://root:TU_PASSWORD_AQUI@localhost:3306/cooperativa_financiera"
#
# Opción 2: XAMPP / MariaDB local (por defecto usuario root sin contraseña)
# DATABASE_URL="mysql://root:@localhost:3306/cooperativa_financiera"
