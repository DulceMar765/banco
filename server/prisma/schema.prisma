  cashier_sessions   cashier_sessions                          @relation(fields: [session_id], references: [id], map: "fk_cash_denomination_session")
  app_users          app_users?                                @relation(fields: [counted_by_user_id], references: [id], map: "fk_cash_denomination_user")

  @@unique([session_id, count_stage, denomination], map: "uq_cash_session_denomination")
  @@index([counted_by_user_id], map: "fk_cash_denomination_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
