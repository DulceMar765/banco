  projection_scenarios       projection_scenarios @relation(fields: [scenario_id], references: [id], map: "fk_projection_result_scenario")

  @@unique([scenario_id, block_number], map: "uq_projection_result_block")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model projection_scenarios {
  id                 BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  model_id           BigInt                             @db.UnsignedBigInt
  scenario_type      projection_scenarios_scenario_type
  name               String                             @db.VarChar(120)
  revenue_factor     Decimal                            @default(1.000000) @db.Decimal(9, 6)
  default_rate       Decimal                            @default(0.000000) @db.Decimal(9, 6)
  assumptions        Json?
  projection_results projection_results[]
  projection_models  projection_models                  @relation(fields: [model_id], references: [id], map: "fk_projection_scenario_model")

  @@unique([model_id, scenario_type], map: "uq_projection_scenario")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model promotions {
  id                     BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  title                  String                   @db.VarChar(180)
  message                String                   @db.VarChar(2000)
  starts_at              DateTime                 @db.DateTime(0)
  ends_at                DateTime                 @db.DateTime(0)
  created_by_user_id     BigInt?                  @db.UnsignedBigInt
  status                 promotions_status        @default(DRAFT)
  created_at             DateTime                 @default(now()) @db.Timestamp(0)
  customer_notifications customer_notifications[]
  app_users              app_users?               @relation(fields: [created_by_user_id], references: [id], map: "fk_promotion_creator")

  @@index([created_by_user_id], map: "fk_promotion_creator")
  @@index([status, starts_at, ends_at], map: "idx_promotions_status_dates")
}

model role_permissions {
  role_id       Int         @db.UnsignedSmallInt
  permission_id Int         @db.UnsignedSmallInt
  permissions   permissions @relation(fields: [permission_id], references: [id], map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [role_id], references: [id], map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permissions_permission")
}

model roles {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  code             String             @unique(map: "code") @db.VarChar(40)
  name             String             @db.VarChar(100)
  description      String?            @db.VarChar(255)
  app_user_roles   app_user_roles[]
  role_permissions role_permissions[]
}

model service_turns {
  id                    BigInt                              @id @default(autoincrement()) @db.UnsignedBigInt
  branch_id             Int                                 @db.UnsignedSmallInt
  customer_id           BigInt?                             @db.UnsignedBigInt
  turn_type_id          Int                                 @db.UnsignedSmallInt
  assigned_to_user_id   BigInt?                             @db.UnsignedBigInt
  priority_snapshot     Int                                 @db.SmallInt
  service_area_snapshot service_turns_service_area_snapshot
  status                service_turns_status                @default(WAITING)
  created_at            DateTime                            @default(now()) @db.DateTime(0)
  called_at             DateTime?                           @db.DateTime(0)
  started_at            DateTime?                           @db.DateTime(0)
  completed_at          DateTime?                           @db.DateTime(0)
  notes                 String?                             @db.VarChar(500)
  app_users             app_users?                          @relation(fields: [assigned_to_user_id], references: [id], map: "fk_turn_assignee")
  branches              branches                            @relation(fields: [branch_id], references: [id], map: "fk_turn_branch")
  customers             customers?                          @relation(fields: [customer_id], references: [id], onDelete: Restrict, map: "fk_turn_customer")
  turn_types            turn_types                          @relation(fields: [turn_type_id], references: [id], map: "fk_turn_type")

  @@index([assigned_to_user_id], map: "fk_turn_assignee")
  @@index([turn_type_id], map: "fk_turn_type")
  @@index([customer_id, created_at], map: "idx_turn_customer")
  @@index([branch_id, status, priority_snapshot(sort: Desc), created_at], map: "idx_turn_queue")
}

model suppliers {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String                  @db.VarChar(180)
  tax_id                String?                 @unique(map: "uq_supplier_tax_id") @db.VarChar(20)
  contact_name          String?                 @db.VarChar(150)
  email                 String?                 @db.VarChar(254)
  phone                 String?                 @db.VarChar(25)
  is_active             Boolean                 @default(true)
  loyalty_catalog_items loyalty_catalog_items[]
}

model turn_types {
  id                Int                     @id @default(autoincrement()) @db.UnsignedSmallInt
  code              String                  @unique(map: "code") @db.VarChar(40)
  name              String                  @db.VarChar(120)
  service_area      turn_types_service_area
  priority          Int                     @default(0) @db.SmallInt
  requires_customer Boolean                 @default(true)
  is_active         Boolean                 @default(true)
  service_turns     service_turns[]
}

