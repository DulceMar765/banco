  opened_by_user_id                                       BigInt                          @db.UnsignedBigInt
  closed_by_user_id                                       BigInt?                         @db.UnsignedBigInt
  opened_at                                               DateTime                        @default(now()) @db.DateTime(0)
  closed_at                                               DateTime?                       @db.DateTime(0)
  opening_cash                                            Decimal                         @default(0.00) @db.Decimal(18, 2)
  counted_cash                                            Decimal?                        @db.Decimal(18, 2)
  notes                                                   String?                         @db.VarChar(500)
  status                                                  cashier_sessions_status         @default(OPEN)
  open_cashier_key                                        BigInt?                         @unique(map: "uq_one_open_session_per_cashier") @db.UnsignedBigInt
  cashier_session_denominations                           cashier_session_denominations[]
  branches                                                branches                        @relation(fields: [branch_id], references: [id], onUpdate: Restrict, map: "fk_cash_session_branch")
  app_users_cashier_sessions_cashier_user_idToapp_users   app_users                       @relation("cashier_sessions_cashier_user_idToapp_users", fields: [cashier_user_id], references: [id], onUpdate: Restrict, map: "fk_cash_session_cashier")
  app_users_cashier_sessions_closed_by_user_idToapp_users app_users?                      @relation("cashier_sessions_closed_by_user_idToapp_users", fields: [closed_by_user_id], references: [id], onUpdate: Restrict, map: "fk_cash_session_closer")
  app_users_cashier_sessions_opened_by_user_idToapp_users app_users                       @relation("cashier_sessions_opened_by_user_idToapp_users", fields: [opened_by_user_id], references: [id], onUpdate: Restrict, map: "fk_cash_session_opener")
  financial_transactions                                  financial_transactions[]

  @@index([branch_id], map: "fk_cash_session_branch")
  @@index([closed_by_user_id], map: "fk_cash_session_closer")
  @@index([opened_by_user_id], map: "fk_cash_session_opener")
  @@index([cashier_user_id, status, opened_at], map: "idx_cash_session_cashier_status")
}

