generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model account_interest_accruals {
  id                      BigInt                           @id @default(autoincrement()) @db.UnsignedBigInt
  account_id              BigInt                           @db.UnsignedBigInt
  accrual_date            DateTime                         @db.Date
  balance_basis           Decimal                          @db.Decimal(18, 2)
  annual_rate             Decimal                          @db.Decimal(9, 6)
  day_count_basis         Int                              @db.UnsignedSmallInt
  interest_amount         Decimal                          @db.Decimal(18, 8)
  status                  account_interest_accruals_status @default(PENDING)
  credited_transaction_id BigInt?                          @db.UnsignedBigInt
  credited_at             DateTime?                        @db.DateTime(0)
  created_at              DateTime                         @default(now()) @db.Timestamp(0)
  accounts                accounts                         @relation(fields: [account_id], references: [id], map: "fk_interest_accrual_account")
  financial_transactions  financial_transactions?          @relation(fields: [credited_transaction_id], references: [id], onDelete: Restrict, map: "fk_interest_accrual_transaction")

  @@unique([account_id, accrual_date], map: "uq_interest_account_day")
  @@index([credited_transaction_id], map: "fk_interest_accrual_transaction")
  @@index([accrual_date, status], map: "idx_interest_accrual_month_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model account_movements {
  id                     BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  transaction_id         BigInt                          @unique(map: "transaction_id") @db.UnsignedBigInt
  account_id             BigInt                          @db.UnsignedBigInt
  movement_type          account_movements_movement_type
  direction              account_movements_direction
  amount                 Decimal                         @db.Decimal(18, 2)
  created_at             DateTime                        @default(now()) @db.DateTime(0)
  accounts               accounts                        @relation(fields: [account_id], references: [id], map: "fk_account_movements_account")
  financial_transactions financial_transactions          @relation(fields: [transaction_id], references: [id], map: "fk_account_movements_transaction")

  @@index([account_id, created_at], map: "idx_account_movements_account_date")
}

model account_number_sequences {
  sequence_name String @id @db.VarChar(40)
  next_value    BigInt @db.UnsignedBigInt
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model accounts {
  id                        BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  account_number            String                      @unique(map: "account_number") @db.VarChar(24)
  customer_id               BigInt                      @db.UnsignedBigInt
  product_id                BigInt                      @db.UnsignedBigInt
  balance                   Decimal                     @default(0.00) @db.Decimal(18, 2)
  status                    accounts_status             @default(ACTIVE)
  opened_at                 DateTime                    @default(now()) @db.DateTime(0)
  closed_at                 DateTime?                   @db.DateTime(0)
  created_by_user_id        BigInt?                     @db.UnsignedBigInt
  account_interest_accruals account_interest_accruals[]
  account_movements         account_movements[]
  app_users                 app_users?                  @relation(fields: [created_by_user_id], references: [id], map: "fk_accounts_creator")
  customers                 customers                   @relation(fields: [customer_id], references: [id], map: "fk_accounts_customer")
  financial_products        financial_products          @relation(fields: [product_id], references: [id], map: "fk_accounts_product")
  daily_balance_snapshots   daily_balance_snapshots[]
  loans                     loans[]

  @@index([created_by_user_id], map: "fk_accounts_creator")
  @@index([customer_id, status], map: "idx_accounts_customer_status")
  @@index([product_id], map: "idx_accounts_product")
}

model app_user_roles {
  user_id                                         BigInt     @db.UnsignedBigInt
  role_id                                         Int        @db.UnsignedSmallInt
  assigned_by                                     BigInt?    @db.UnsignedBigInt
  assigned_at                                     DateTime   @default(now()) @db.Timestamp(0)
  app_users_app_user_roles_assigned_byToapp_users app_users? @relation("app_user_roles_assigned_byToapp_users", fields: [assigned_by], references: [id], map: "fk_user_roles_assigner")
  roles                                           roles      @relation(fields: [role_id], references: [id], map: "fk_user_roles_role")
  app_users_app_user_roles_user_idToapp_users     app_users  @relation("app_user_roles_user_idToapp_users", fields: [user_id], references: [id], map: "fk_user_roles_user")

  @@id([user_id, role_id])
  @@index([assigned_by], map: "fk_user_roles_assigner")
  @@index([role_id], map: "fk_user_roles_role")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model app_users {
  id                                                             BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  username                                                       String                          @unique(map: "username") @db.VarChar(100)
  email                                                          String                          @unique(map: "email") @db.VarChar(254)
  password_hash                                                  String                          @db.VarChar(255)
  customer_id                                                    BigInt?                         @unique(map: "customer_id") @db.UnsignedBigInt
  employee_id                                                    BigInt?                         @unique(map: "employee_id") @db.UnsignedBigInt
  is_enabled                                                     Boolean                         @default(true)
  last_login_at                                                  DateTime?                       @db.DateTime(0)
  created_at                                                     DateTime                        @default(now()) @db.Timestamp(0)
  accounts                                                       accounts[]
  app_user_roles_app_user_roles_assigned_byToapp_users           app_user_roles[]                @relation("app_user_roles_assigned_byToapp_users")
  app_user_roles_app_user_roles_user_idToapp_users               app_user_roles[]                @relation("app_user_roles_user_idToapp_users")
  customers                                                      customers?                      @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_app_users_customer")
  employees                                                      employees?                      @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_app_users_employee")
  cashier_session_denominations                                  cashier_session_denominations[]
  cashier_sessions_cashier_sessions_cashier_user_idToapp_users   cashier_sessions[]              @relation("cashier_sessions_cashier_user_idToapp_users")
  cashier_sessions_cashier_sessions_closed_by_user_idToapp_users cashier_sessions[]              @relation("cashier_sessions_closed_by_user_idToapp_users")
  cashier_sessions_cashier_sessions_opened_by_user_idToapp_users cashier_sessions[]              @relation("cashier_sessions_opened_by_user_idToapp_users")
  collection_cases                                               collection_cases[]
  collection_reports                                             collection_reports[]
  customer_documents                                             customer_documents[]
  customer_income_records                                        customer_income_records[]
  education_events                                               education_events[]
  financial_transactions                                         financial_transactions[]
  interest_rate_plans                                            interest_rate_plans[]
  loan_applications                                              loan_applications[]
  loan_approvals                                                 loan_approvals[]
  loyalty_movements                                              loyalty_movements[]
  product_applications                                           product_applications[]
  projection_models                                              projection_models[]
  promotions                                                     promotions[]
  service_turns                                                  service_turns[]

  @@index([is_enabled], map: "idx_app_users_enabled")
}

model audit_logs {
  id            BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  actor_user_id BigInt?           @db.UnsignedBigInt
  entity_name   String            @db.VarChar(80)
  entity_pk     String            @db.VarChar(100)
  action        audit_logs_action
  old_data      Json?
  new_data      Json?
  connection_id BigInt            @db.UnsignedBigInt
  occurred_at   DateTime          @default(now()) @db.Timestamp(0)

  @@index([actor_user_id, occurred_at], map: "idx_audit_actor_date")
  @@index([entity_name, entity_pk, occurred_at], map: "idx_audit_entity")
}

model branches {
  id               Int                @id @default(autoincrement()) @db.UnsignedSmallInt
  code             String             @unique(map: "code") @db.VarChar(20)
  name             String             @db.VarChar(120)
  address          String?            @db.VarChar(255)
  phone            String?            @db.VarChar(25)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamp(0)
  cashier_sessions cashier_sessions[]
  employees        employees[]
  service_turns    service_turns[]
}

model business_calendar {
  calendar_date   DateTime @id @db.Date
  is_business_day Boolean
  description     String?  @db.VarChar(160)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cashier_session_denominations {
  id                 BigInt                                    @id @default(autoincrement()) @db.UnsignedBigInt
  session_id         BigInt                                    @db.UnsignedBigInt
  count_stage        cashier_session_denominations_count_stage
  denomination       Decimal                                   @db.Decimal(8, 2)
  quantity           Int                                       @db.UnsignedInt
  counted_by_user_id BigInt?                                   @db.UnsignedBigInt
